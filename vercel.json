{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "installCommand": "echo 'Static CDN deployment - skipping backend install'",
  "outputDirectory": ".",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/admin", "destination": "/templates/admin.html" },
    { "source": "/certificate", "destination": "/templates/certificate.html" },
    { "source": "/verify/:path*", "destination": "/templates/certificate.html" },
    { "source": "/static/:path*", "destination": "/static/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}

