# Feynman AI Learning OS — Environment Variables Example Template

# Backend API Settings
PORT=8000
SECRET_KEY=generate_a_random_secure_secret_key_here
DATABASE_URL=sqlite:///./feynman.db

# AI Provider & Multi-Credential Gateway Configuration
AI_PROVIDER=gemini
GEMINI_MODEL=gemini-flash-latest
GEMINI_API_KEY_1=your_primary_gemini_api_key
GEMINI_API_KEY_2=your_secondary_gemini_api_key
GEMINI_API_KEY_3=your_tertiary_gemini_api_key
GEMINI_MAX_RETRIES=3
GEMINI_TIMEOUT_SECONDS=45
GEMINI_BACKOFF_BASE_SECONDS=1.0

# Frontend Client Settings
VITE_API_URL=http://localhost:8000

# Optional Production Email SMTP Settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
SMTP_FROM=verify@feynmantutor.local
