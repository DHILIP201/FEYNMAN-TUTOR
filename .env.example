# --- GENERAL CONFIG ---
AUTH_MODE=development # 'development' (auto-verify) | 'production' (SMTP email verify)
APP_HOST=http://127.0.0.1:8000
JWT_SECRET=replace-this-with-a-secure-secret-key

# --- DATABASE CONFIG ---
# Default to SQLite feynman.db locally. Replace with postgresql:// connection string in production
# DATABASE_URL=postgresql://user:password@host:port/dbname

# --- AI CONFIG ---
GEMINI_API_KEY=your-gemini-api-key-here

# --- SMTP EMAIL CONFIG (Required if AUTH_MODE=production) ---
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USERNAME=resend
SMTP_PASSWORD=re-your-smtp-password-secret
SMTP_FROM=verify@yourdomain.com
