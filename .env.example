# Feynman AI Learning OS — Environment Variables Example Template

# Backend API Settings
PORT=8000
SECRET_KEY=generate_a_random_secure_secret_key_here
DATABASE_URL=sqlite:///./feynman.db

# AI Provider Configuration
AI_PROVIDER=gemini
AI_MODEL_NAME=gemini-2.5-flash
GEMINI_API_KEY=your_gemini_api_key_here

# Frontend Client Settings
VITE_API_URL=http://localhost:8000

# Optional Production Email SMTP Settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
SMTP_FROM=verify@feynmantutor.local
